# Copy to .env (never commit .env). Values below are placeholders.
AVIRAT_ENV=development
AVIRAT_SECRET_KEY=change-me
AVIRAT_DATABASE_URL=mysql+pymysql://avirat:change-me@localhost:3306/avirat?charset=utf8mb4
AVIRAT_TEST_DATABASE_URL=mysql+pymysql://avirat:change-me@localhost:3306/avirat_test?charset=utf8mb4
AVIRAT_BASE_URL=https://avirat.iconsolar
AVIRAT_PORT=8080
AVIRAT_TIMEZONE=Asia/Kolkata
# Push sender: "log" for development, "fcm" once open question O-1 is settled
AVIRAT_PUSH_SENDER=log
AVIRAT_FCM_SERVICE_ACCOUNT_FILE=C:\avirat\secrets\fcm-service-account.json
